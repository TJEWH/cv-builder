    },
    "source_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://[^\\s]+$"
    },
    "application_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(https?://[^\\s]+|mailto:[^\\s@?]+@[^\\s@?]+(?:\\?[^\\s]*)?)$"
