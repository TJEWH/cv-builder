      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "kind",
          "checked_at",
          "supports"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "official",
              "official_listing",
              "institution",
              "graduate_school",
              "discovery",
              "unknown"
            ]
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string",
                "format": "date"
              }
            ]
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unmapped_supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
