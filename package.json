{
  "name": "cv-generator-vue",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "tsx --test test/*.test.ts",
    "test:opportunity-merge": "tsx --test test/opportunityMerge/merge.test.ts",
    "test:opportunity-canonical": "tsx --test test/opportunityCanonical/canonical.test.ts",
    "test:opportunity-feedback": "tsx --test test/opportunityFeedback/database.test.ts",
    "test:opportunity-feedback-sharing": "tsx --test test/opportunityFeedback/sharing.test.ts",
    "test:adaptive-feedback-snapshots": "tsx --test test/opportunityFeedback/snapshots.test.ts",
    "test:adaptive-search-plans": "tsx --test test/opportunityFeedback/plans.test.ts",
    "test:adaptive-search-attribution": "tsx --test test/opportunityFeedback/attribution.test.ts",
    "test:adaptive-search-preferences": "tsx --test test/opportunityFeedback/preferences.test.ts",
    "test:refinement": "tsx --test test/*Refinement*.test.ts test/refinement*.test.ts test/cloudCvPrivacy.test.ts test/useDocumentPdfPreview.test.ts",
    "refinement:prompts": "tsx test/refinementProtocol/generate.ts",
    "refinement:prompts:check": "tsx test/refinementProtocol/generate.ts --check",
    "test:refinement-protocol": "tsx --test test/refinementProtocol.test.ts",
    "refinement:live": "tsx test/refinementProtocol/run.ts",
    "test:e2e:serve": "vite --config test/e2e/vite.config.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@primeuix/themes": "^1.2.5",
    "@supabase/supabase-js": "2.116.0",
    "fontkit": "2.0.4",
    "html2canvas": "1.4.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "primevue": "^4.5.5",
    "svg-to-pdfkit": "0.1.8",
    "vue": "^3.5.24",
    "vuedraggable": "^4.1.0",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.1",
    "@types/pdfkit": "^0.17.6",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  }
}
