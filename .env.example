# Optional. Leave both blank for a fully local, standalone CV builder.
# These public values are embedded into the static frontend at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional for custom Supabase domains. Hosted <ref>.supabase.co URLs resolve automatically.
VITE_SUPABASE_PROJECT_REF=

# Existing NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# are accepted as a compatibility fallback. Prefer the VITE_ names above.
# Never add a secret key, service_role key, database password, or user password.
