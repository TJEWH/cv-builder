{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical opportunity payload v5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "vacancy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "institution": {
      "type": [
        "string",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "position_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "availability": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadline_original_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "research_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_details": {
      "type": [
        "string",
        "null"
      ]
    },
    "particularly_suitable_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "opportunity_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "verification_level": {
      "type": "string"
    },
    "official_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://+$"
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://+$"
    },
    "application_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(https?://[^\\s]+|mailto:[^\\s@?]+@[^\\s@?]+(?:\\?[^\\s]*)?)$"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "deadline_time_local": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "deadline_timezone": {
      "type": [
        "string",
        "null"
      ],
      "format": "opportunity-timezone"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "special_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supervisors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checklist"
      }
    },
    "required_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checklist"
      }
    },
    "supervisor_research_focus": {
      "$ref": "#/$defs/focus"
    },
    "supervisor_top_papers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paper"
      }
    },
    "salary": {
      "$ref": "#/$defs/salary"
    },
    "supervisor_reputation": {
      "$ref": "#/$defs/background"
    },
    "hardware_software_balance": {
      "$ref": "#/$defs/balance"
    },
    "personal_fit": {
      "$ref": "#/$defs/assessment"
    },
    "rd_career_potential": {
      "$ref": "#/$defs/assessment"
    },
    "research_career_potential": {
      "$ref": "#/$defs/assessment"
    },
    "particularly_suitable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "last_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "required": [
    "opportunity_key",
    "title",
    "last_checked_at",
    "sources"
  ],
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://+$"
          }
        }
      },
      "required": [
        "label",
        "text"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "role_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supervision_confirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "orcid": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "institution": {
          "type": [
            "string",
            "null"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://+$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "entity_id",
        "roles"
      ]
    },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "conditional",
            "preferred",
            "recommended",
            "desired",
            "advantageous",
            "unspecified"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "unspecified",
            "recruitment",
            "doctoral_admission",
            "after_selection",
            "interview",
            "offer",
            "enrolment",
            "other"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_pages": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_words": {
          "type": [
            "number",
            "null"
          ]
        },
        "file_formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "entity_id",
        "text",
        "status",
        "stage"
      ]
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://+$"
        },
        "year": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1000,
          "maximum": 2200
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supervisors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selection_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "relevance": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://+$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "entity_id"
      ]
    },
    "focus_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "researcher_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://+$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "entity_id",
        "name"
      ]
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/focus_profile"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "money_component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "year",
            "contract",
            null
          ]
        },
        "gross": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "entity_id",
        "label"
      ]
    },
    "salary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "year",
            "contract",
            null
          ]
        },
        "gross": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/money_component"
          }
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://+$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "scale_min": {
          "type": "number",
          "const": 0
        },
        "scale_max": {
          "type": "number",
          "const": 10
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "subscores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "score",
        "scale_min",
        "scale_max",
        "summary"
      ],
      "anyOf": [
        {
          "properties": {
            "score": {
              "type": "number"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "properties": {
            "score": {
              "const": null
            }
          }
        }
      ]
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://+$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "balance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "hardware": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "software": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "official",
            "official_listing",
            "institution",
            "graduate_school",
            "discovery",
            "unknown"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "instant",
            "date",
            "unknown"
          ]
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "source_id",
        "url",
        "kind",
        "checked_at",
        "precision",
        "supports"
      ],
      "anyOf": [
        {
          "properties": {
            "precision": {
              "const": "instant"
            },
            "checked_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "properties": {
            "precision": {
              "const": "date"
            },
            "checked_at": {
              "type": "string",
              "format": "date"
            }
          }
        },
        {
          "properties": {
            "precision": {
              "const": "unknown"
            },
            "checked_at": {
              "const": null
            }
          }
        }
      ]
    },
    "living_standard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "housing_baseline": {
          "type": "string",
          "enum": [
            "shared_flat",
            "private_apartment"
          ]
        },
        "assessed_at": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "summary": {
          "type": "string"
        },
        "salary_basis": {
          "type": "string"
        },
        "budget_basis": {
          "type": "string"
        },
        "funding_note": {
          "type": "string"
        },
        "factors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "affordability": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 10
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "score",
                "reason"
              ]
            },
            "housing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 10
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "score",
                "reason"
              ]
            },
            "culture": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 10
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "score",
                "reason"
              ]
            },
            "nature": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 10
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "score",
                "reason"
              ]
            },
            "student_life": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 10
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
